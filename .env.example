# ⚠️ ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local and fill with YOUR OWN values
# NEVER commit .env.local to git

# Next.js / Development
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# Cron endpoint protection (generate with: openssl rand -hex 32)
CRON_AUTH_TOKEN=your_cron_auth_token_here

# LLM Provider API Keys (all optional — seed data is used as fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# Turso / libSQL (production database — leave blank for local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe (subscription billing for premium API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API Rate Limiting (Optional)
RATE_LIMIT_PER_MINUTE=100
PREMIUM_RATE_LIMIT_PER_MINUTE=1000
